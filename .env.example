# Copier ce fichier vers .env puis renseigner des valeurs propres a votre
# environnement. docker-compose.yml lit ce fichier automatiquement.

# CLE SECRETE JWT (obligatoire)
# Generez une valeur avec :  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RAM_SECRET_KEY=remplacez-par-une-chaine-aleatoire-longue

# Facultatif : duree de validite des jetons en minutes (defaut 720).
# RAM_TOKEN_EXPIRE=720

# En production, surchargez egalement le mot de passe PostgreSQL :
#   POSTGRES_PASSWORD=remplacez-par-un-mot-de-passe-fort
# (doit alors correspondre a celui reference dans DATABASE_URL ci-dessous)
DATABASE_URL=postgresql://ram:ram_password@db:5432/ram_flights
